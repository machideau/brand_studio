# ──────────────────────────────────────────────
# Brand Studio — Environment Variables Example
# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local to version control.
# ──────────────────────────────────────────────

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAFakeTokenExampleDoNotUse
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-string
TELEGRAM_ALLOWED_USER_ID=123456789

# RodiumAI
RODIUMAI_API_KEY=rodi-fake-api-key-example
RODIUMAI_BASE_URL=https://api.rodiumai.example.com

# Inngest
INNGEST_SIGNING_KEY=signkey-prod-fakeexample0000000000000000000000
INNGEST_EVENT_KEY=fake-inngest-event-key-example

# Cost & retry configuration
SPEND_CAP_RODI=100
MAX_RETRIES=3
FILE_TTR_HOURS=48
